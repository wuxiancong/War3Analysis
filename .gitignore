# Windows crash / hang dumps (keep stacks / notes as text)
*.dmp

# Game binaries (keep README / patch scripts only)
*.dll
*.exe
samples/**/*.dll
samples/**/*.exe

# Ghidra project DBs (keep scripts under shared/ghidra-scripts/)
ghidra/projects/
*.gpr
*.rep/
*.gbf
*.prp

# Python cache
**/__pycache__/
*.py[cod]

# Maps / local binaries (optional local copies)
maps/**/*.w3x
maps/**/*.w3m
*.mpq
